# ============================================================
# novelcomic 生产环境配置模板
#
# .cnb.yml 部署时会在服务器 touch 一个 backend.env，
# 再由 docker-compose 挂载为容器内 /app/.env，app 用 pydantic 读取。
#
# 恢复/初始化流程：
#   1. 拷贝本模板到服务器：
#        scp backend.env.example user@your-server:/root/novelcomic/backend.env
#   2. SSH 填入真实值：vim /root/novelcomic/backend.env
#   3. 重启后端：cd /root/novelcomic && docker restart novelcomic-backend
#
# ⚠️ 本文件只是模板、可入 git；真实 backend.env 永不 commit（.gitignore 已忽略）。
# ⚠️ 部署脚本每次只会自动回注 VOLC_AK / VOLC_SK（从 kitee/tcloud.yml）；
#    其余键一旦 backend.env 被清空就不会自动恢复，需照本模板手动补。
# ============================================================

# === 数据库 ===
# 生产由 docker-compose 的 environment 覆盖为容器内 postgres，无需在此填。
# DATABASE_URL=postgresql://postgres:123456@postgres:5432/novelcomic

# === 文本大模型（硅基流动 OpenAI 兼容；也用于 TTS CosyVoice2）===
# 注意：运行时 key 实际走数据库 model_profiles（启动 seed 时从这里灌进 DB）。
# 改了 key 想让线上生效：改 backend.env 后，要么删对应 model_profiles 档重启重新 seed，
# 要么直接在「系统管理 → 模型管理」页粘贴新 key。
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# === GRSAI（图/视频，当前默认激活的生图生视频档）===
GRSAI_BASE_URL=https://grsai.dakka.com.cn/v1
GRSAI_API_KEY=
GRSAI_IMAGE_MODEL=nano-banana-fast
GRSAI_VIDEO_MODEL=veo3.1-fast

# === 火山方舟 推理 API（Seedream 生图 / Seedance 生视频）===
# ARK_API_KEY 是「方舟推理」的 Bearer Key，和下面 VOLC_AK/SK 是两码事，不能互相替代。
# 资源包一键插入模型管理时，凭据补的就是 ARK_API_KEY；此处为空 → 插进去的档就没 key。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_VIDEO_MODEL=doubao-seedance-1-5-pro

# === 阿里云百炼 DashScope（OpenAI 兼容模式）===
# 与方舟并列的第二家：免费额度 / Token Plan 资源包。工作空间专属 Key（sk-ws-…）有自己的
# maas 域名，控制台「OpenAI 兼容地址」是什么就填什么；主账号通用 Key 用默认 dashscope 域名。
# 资源包页把百炼模型插入模型管理时，凭据补的就是 DASHSCOPE_API_KEY；此处为空 → 插进去的档没 key。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_TEXT_MODEL=qwen-plus

# === 火山方舟 私域素材库（Assets API，AK/SK V4 签名，≠ ARK_API_KEY）===
# 这两个键由 .cnb.yml 部署时自动回注，一般无需手填。
VOLC_AK=
VOLC_SK=
VOLC_ASSET_HOST=open.volcengineapi.com
VOLC_ASSET_REGION=cn-beijing
VOLC_ASSET_SERVICE=ark
VOLC_ASSET_VERSION=2024-01-01
# 素材所属项目，须与生视频 API Key 所属项目一致
ARK_PROJECT_NAME=default

# === 阿里云 OSS 转存（生成产物落 OSS；配置来源同 cocc-work）===
# OSS 直接读本配置、不走数据库——backend.env 丢了 OSS 就直接坏（上传失败）。
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=
OSS_BASE_URL=
